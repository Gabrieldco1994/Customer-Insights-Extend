table opportunity
	lineageTag: 2c45c815-1987-45e4-a6f5-3240db5396c2
	sourceLineageTag: [dbo].[opportunity]

	measure 'Opp Count' = ```
			
			DISTINCTCOUNT(Opportunity[opportunityid]) 
			```
		formatString: 0
		lineageTag: b3ba1c48-9abd-42b0-a2a0-59f0ec9337e8

		changedProperty = Name

	measure 'MKT Estimated Revenue' =
			
			SUM(Opportunity[estimatedvalue])
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: f8c80ac6-1955-40e9-a308-bfc2310b569e

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Won Revenue' =
			
			CALCULATE(
			    SUM(Opportunity[actualvalue]),
			    Opportunity[statecode] = 1
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 21cadcdd-37b4-4b15-b22e-229adb527e8d

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'N converted opportunities' = ```
			
			CALCULATE (
			    DISTINCTCOUNT ( Opportunity[opportunityid] ),
			    FILTER (
			        Opportunity,
			        NOT ( ISBLANK ( Opportunity[originatingleadid] ) )
			    )
			)
			
			```
		formatString: 0
		lineageTag: 262ef110-7ef3-4e10-9fc4-3dd1e406a019

		changedProperty = Name

	measure '% lead conversion' = ```
			DIVIDE ( [N converted opportunities], [leads generated by marketing], 0 )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7b6d01d8-11d9-44e3-ab5c-7d485bd468b4

		changedProperty = Name

		changedProperty = FormatString

	measure 'Estimated Revenue by Lead Conversion' = ```
			
			CALCULATE (
			    SUM ( Opportunity[estimatedvalue] ),
			    NOT ( ISBLANK ( Opportunity[originatingleadid] ) )
			)
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 57518049-a4e8-48fe-9fa3-ac9bc7527fdf

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Customer Acquisition Cost CAC' = ```
			
			DIVIDE (
			    SUM ( msdynmkt_journey[crfc2_custototaldajornada] ),
			    [Won Revenue],
			    0
			)
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 15bd0a5a-615e-49c2-94d4-f48d45a3482b

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

